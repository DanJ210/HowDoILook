# Required environment variables — copy to .env and fill in values.
# Use double underscores so .NET binds them to configuration sections like Queue:* and Jwt:*.
# Never commit the actual .env file.

# ── Azure Storage Queue ──────────────────────────────────────────
Queue__ConnectionString=
Queue__FaceAnalysisQueueName=analysis-jobs
Queue__StyleQueueName=style-jobs
Queue__QueueName=style-jobs

# ── Azure Blob Storage ───────────────────────────────────────────
BlobStorage__ConnectionString=
BlobStorage__ContainerName=style-assets

# ── JWT (Backend API) ────────────────────────────────────────────
Jwt__Key=
Jwt__Issuer=ai-style-app
Jwt__Audience=ai-style-app-client
